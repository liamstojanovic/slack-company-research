# Slack Configuration (Required)
# https://docs.slack.dev/tools/node-slack-sdk/getting-started/#get-a-token-to-use-the-web-api
# Starts with `xoxb...`
SLACK_BOT_USER_OAUTH_ACCESS_TOKEN=

# AWS Configuration
# Claude is accessed via AWS Bedrock. Ensure your AWS profile has Bedrock access.
# Credentials are loaded from your AWS profile (default: "liam") configured in ~/.aws/credentials
# Region is set to us-east-1 by default in the application.

# Application Configuration
NODE_ENV=development
PORT=3000