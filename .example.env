# Slack Configuration (Required)
# https://docs.slack.dev/tools/node-slack-sdk/getting-started/#get-a-token-to-use-the-web-api
# Starts with `xoxb...`
SLACK_BOT_USER_OAUTH_ACCESS_TOKEN=

# AWS Configuration
# Claude is accessed via AWS Bedrock. Ensure your AWS profile has Bedrock access.
# For local development, set AWS_PROFILE to your profile name from ~/.aws/credentials
# On Lambda, credentials are provided by the execution role automatically.
AWS_PROFILE=
AWS_REGION=us-east-1

# Application Configuration
NODE_ENV=development
PORT=3000